---
import Layout from '../layouts/Layout.astro';

// Componentes modulares
import Hero from '../components/ui/Hero.astro';
import Tabs from '../components/ui/Tabs.astro';

// Secciones de contenido (Agrega nuevas aquí fácilmente)
import Win10Section from '../components/sections/Win10Section.astro';
import Win11Section from '../components/sections/Win11Section.astro';
import ActWinSection from '../components/sections/ActWinSection.astro';

// Lógica del cliente
import MainScripts from '../components/scripts/MainScripts.astro';
---

<Layout title="Optimización Windows 10 y 11 — Guía">
  <main>
    <!-- HERO -->
    <Hero />

    <!-- TABS SELECTOR -->
    <Tabs />

    <!-- CONTENEDORES DE SO -->
    <Win10Section />
    <Win11Section />
    <ActWinSection />
  </main>

  <!-- Lógica y Animaciones -->
  <MainScripts />
</Layout>
